# Containerized Codex Agent quickstart defaults
# Update the values below before running ./scripts/quickstart.sh

# Runtime pins (informational; the script will warn if your versions differ)
PYTHON_VERSION=3.11.9
NODE_VERSION=22.3.0
DOCKER_VERSION=26.0.0

# Preferred python binary used for virtualenv creation
PYTHON_BIN=python3.11

# FastAPI base URL (adjust if you bind the server elsewhere)
BACKEND_API_BASE=http://127.0.0.1:8000

# Project registration payload
PROJECT_NAME=codex-agent-sandbox
PROJECT_DEFAULT_BRANCH=main
# Repositories are cached in project-cache/<slug>/repo; override PROJECT_CACHE_ROOT to move the cache.
GITLAB_HOST=https://gitlab.com
GITLAB_PROJECT_PATH=group/project/project-repo
GITLAB_PAT=

# Path to the ChatGPT session bundle (contents of ~/.codex/auth.json after `codex login`).
CHATGPT_SESSION_BUNDLE_PATH=chatgpt_session_bundle.json

# Alternatively, embed the bundle contents directly (takes precedence over the path).
# Copy helpers for ~/.codex/auth.json (paste into the variables below):
#   macOS  : cat ~/.codex/auth.json | pbcopy
#   Linux  : cat ~/.codex/auth.json | xclip -selection clipboard
#   Windows: Get-Content $env:USERPROFILE\.codex\auth.json | Set-Clipboard
# CHATGPT_SESSION_JSON='{"session_token":"..."}'

# Encryption key for stored credentials (urlsafe base64, 32 bytes when decoded)
# Generate with: python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Task submission defaults
TASK_PROMPT=Quickstart sanity check

# Leave this enabled for dry runs; set to 0 to push real branches/MRs
RUNNER_GIT_DRY_RUN=1

# Optional overrides
# PROJECT_CACHE_ROOT=project-cache
# WORKER_MAX_CONCURRENCY=10       # default global pool size; set WORKER_ENABLE_PARALLEL=0 to force serial mode
# PROJECT_MAX_CONCURRENCY_DEFAULT=10       # fallback per-project concurrency limit when /settings/concurrency is unset
