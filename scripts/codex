#!/usr/bin/env python3
"""Lightweight Codex helper for credential rotation/clear flows."""

from __future__ import annotations

import argparse
import os
import sys
import json
from pathlib import Path
from typing import Any, Dict, List, Optional

import requests

DEFAULT_API_BASE = "http://127.0.0.1:8000"
ENV_BACKEND_API_BASE = "BACKEND_API_BASE"
TIMEOUT_SECONDS = 10


def _resolve_api_base(value: str | None) -> str:
    base = value or os.getenv(ENV_BACKEND_API_BASE) or DEFAULT_API_BASE
    return base.rstrip("/")


def _dry_run_enabled(request_flag: bool) -> bool:
    env_flag = os.getenv("RUNNER_GIT_DRY_RUN", "0").strip()
    return request_flag or env_flag.lower() in {"1", "true", "yes"}


def _print_status(action: str, payload: Dict[str, Any]) -> None:
    pat_configured = "yes" if payload.get("configured") else "no"
    pat_updated_at = payload.get("updated_at") or "--"
    pat_updated_by = payload.get("updated_by") or "--"
    session_configured = "yes" if payload.get("session_configured") else "no"
    session_updated_at = payload.get("session_updated_at") or "--"
    session_updated_by = payload.get("session_updated_by") or "--"
    active = payload.get("active_credential", "none")
    print(
        "PAT {action} (configured={configured}, updated_at={updated_at}, updated_by={updated_by})".format(
            action=action,
            configured=pat_configured,
            updated_at=pat_updated_at,
            updated_by=pat_updated_by,
        )
    )
    print(
        "ChatGPT session (configured={configured}, updated_at={updated_at}, "
        "updated_by={updated_by}, active={active})".format(
            configured=session_configured,
            updated_at=session_updated_at,
            updated_by=session_updated_by,
            active=active,
        )
    )


def _api_request(
    api_base: str,
    method: str,
    path: str,
    payload: Optional[Dict[str, Any]] = None,
) -> Any:
    url = f"{api_base}{path}"
    request_kwargs: Dict[str, Any] = {"timeout": TIMEOUT_SECONDS}
    if payload is not None:
        request_kwargs["json"] = payload

    try:
        response = requests.request(method, url, **request_kwargs)
    except requests.RequestException as exc:  # noqa: BLE001 - surface networking issues
        raise RuntimeError(f"{method} {path} failed: {exc}") from exc

    if response.status_code >= 400:
        detail = response.text.strip() or response.reason
        raise RuntimeError(f"{method} {path} failed ({response.status_code}): {detail}")

    if not response.content:
        return None

    try:
        return response.json()
    except ValueError:
        return None


def store_pat(args: argparse.Namespace) -> int:
    if _dry_run_enabled(args.dry_run):
        print("[dry-run] Skipping PAT store request; no network call performed")
        return 0

    api_base = _resolve_api_base(args.api_base)
    payload: Dict[str, Any] = {"token": args.token.strip()}
    if not payload["token"]:
        print("error: token must not be empty", file=sys.stderr)
        return 1
    if args.actor and args.actor.strip():
        payload["updated_by"] = args.actor.strip()

    url = f"{api_base}/integrations/pat"
    try:
        response = requests.post(url, json=payload, timeout=TIMEOUT_SECONDS)
    except requests.RequestException as exc:  # noqa: BLE001 - surface networking issues
        print(f"error: failed to store PAT ({exc})", file=sys.stderr)
        return 1

    if response.status_code >= 400:
        detail = response.text.strip() or response.reason
        print(f"error: store request failed ({response.status_code}): {detail}", file=sys.stderr)
        return 1

    try:
        data = response.json()
    except ValueError:
        data = {}

    if getattr(args, "deprecated_command", False):
        print("warning: 'codex pat rotate' is deprecated; use 'codex pat store' instead", file=sys.stderr)

    _print_status("stored", data)
    return 0


def clear_pat(args: argparse.Namespace) -> int:
    if _dry_run_enabled(args.dry_run):
        print("[dry-run] Skipping PAT clear request; no network call performed")
        return 0

    api_base = _resolve_api_base(args.api_base)
    payload: Dict[str, Any] = {}
    if args.actor and args.actor.strip():
        payload["updated_by"] = args.actor.strip()

    url = f"{api_base}/integrations/pat"
    try:
        response = requests.request(
            "DELETE",
            url,
            json=payload,
            timeout=TIMEOUT_SECONDS,
        )
    except requests.RequestException as exc:  # noqa: BLE001 - surface networking issues
        print(f"error: failed to clear PAT ({exc})", file=sys.stderr)
        return 1

    if response.status_code >= 400:
        detail = response.text.strip() or response.reason
        print(f"error: clear request failed ({response.status_code}): {detail}", file=sys.stderr)
        return 1

    try:
        data = response.json()
    except ValueError:
        data = {}
    _print_status("cleared", data)
    return 0


def import_chatgpt_session(args: argparse.Namespace) -> int:
    if _dry_run_enabled(args.dry_run):
        print("[dry-run] Skipping ChatGPT session import; no network call performed")
        return 0

    api_base = _resolve_api_base(args.api_base)
    if args.file:
        try:
            bundle = Path(args.file).read_text(encoding="utf-8")
        except OSError as exc:  # noqa: BLE001
            print(f"error: failed to read bundle file ({exc})", file=sys.stderr)
            return 1
    else:
        bundle = args.bundle or ""

    if not bundle.strip():
        print("error: session bundle must not be empty", file=sys.stderr)
        return 1

    payload: Dict[str, Any] = {"bundle": bundle}
    if args.actor and args.actor.strip():
        payload["updated_by"] = args.actor.strip()

    url = f"{api_base}/integrations/pat/session"
    try:
        response = requests.post(url, json=payload, timeout=TIMEOUT_SECONDS)
    except requests.RequestException as exc:  # noqa: BLE001
        print(f"error: failed to import ChatGPT session ({exc})", file=sys.stderr)
        return 1

    if response.status_code >= 400:
        detail = response.text.strip() or response.reason
        print(
            f"error: import request failed ({response.status_code}): {detail}",
            file=sys.stderr,
        )
        return 1

    try:
        data = response.json()
    except ValueError:
        data = {}
    _print_status("status", data)
    return 0


def clear_chatgpt_session(args: argparse.Namespace) -> int:
    if _dry_run_enabled(args.dry_run):
        print("[dry-run] Skipping ChatGPT session clear request; no network call performed")
        return 0

    api_base = _resolve_api_base(args.api_base)
    payload: Dict[str, Any] = {}
    if args.actor and args.actor.strip():
        payload["updated_by"] = args.actor.strip()

    url = f"{api_base}/integrations/pat/session"
    try:
        response = requests.request(
            "DELETE",
            url,
            json=payload,
            timeout=TIMEOUT_SECONDS,
        )
    except requests.RequestException as exc:  # noqa: BLE001
        print(f"error: failed to clear ChatGPT session ({exc})", file=sys.stderr)
        return 1

    if response.status_code >= 400:
        detail = response.text.strip() or response.reason
        print(f"error: clear request failed ({response.status_code}): {detail}", file=sys.stderr)
        return 1

    try:
        data = response.json()
    except ValueError:
        data = {}
    _print_status("status", data)
    return 0


def _parse_allowlist(entries: Optional[List[str]]) -> tuple[Optional[List[str]], bool]:
    if not entries:
        return None, False

    parsed: List[str] = []
    for raw_entry in entries:
        if raw_entry is None:
            continue
        for piece in raw_entry.split(","):
            candidate = piece.strip()
            if candidate:
                parsed.append(candidate)

    if not parsed:
        return [], True
    return parsed, True


def _read_session_bundle_inline(path_value: Optional[str], inline_value: Optional[str]) -> Optional[str]:
    if inline_value and inline_value.strip():
        return inline_value

    if not path_value:
        return None

    try:
        bundle_path = Path(path_value).expanduser()
        contents = bundle_path.read_text(encoding="utf-8")
    except OSError as exc:  # noqa: BLE001 - propagate to caller
        raise RuntimeError(f"Failed to read session bundle: {exc}") from exc

    stripped = contents.strip()
    return stripped or None


def _bootstrap_handle_credentials(
    api_base: str,
    actor: Optional[str],
    gitlab_pat: Optional[str],
    project_pat: Optional[str],
    session_bundle_path: Optional[str],
    session_bundle_inline: Optional[str],
) -> Dict[str, Any]:
    pat_status: Optional[Dict[str, Any]] = None

    primary_pat = (gitlab_pat or "").strip()
    secondary_pat = (project_pat or "").strip()
    if primary_pat and secondary_pat and primary_pat != secondary_pat:
        print(
            "warning: project-level PAT overrides are not supported; using --gitlab-pat value",
            file=sys.stderr,
        )
    if not primary_pat and secondary_pat:
        primary_pat = secondary_pat

    if primary_pat:
        payload: Dict[str, Any] = {"token": primary_pat}
        if actor:
            payload["updated_by"] = actor
        pat_status = _api_request(api_base, "POST", "/integrations/pat", payload)

    session_bundle = _read_session_bundle_inline(session_bundle_path, session_bundle_inline)
    if session_bundle:
        payload = {"bundle": session_bundle}
        if actor:
            payload["updated_by"] = actor
        pat_status = _api_request(api_base, "POST", "/integrations/pat/session", payload)

    if pat_status is None:
        snapshot = _api_request(api_base, "GET", "/integrations/pat")
        if isinstance(snapshot, dict):
            pat_status = snapshot
        else:
            pat_status = {}

    return pat_status


def _select_existing_project(
    projects: List[Dict[str, Any]],
    host: str,
    project_path: str,
    name: Optional[str],
) -> Optional[Dict[str, Any]]:
    for candidate in projects:
        if host and project_path:
            if (
                candidate.get("gitlab_host", "").rstrip("/") == host
                and candidate.get("gitlab_project_path", "").strip("/") == project_path
            ):
                return candidate

    if name:
        for candidate in projects:
            if candidate.get("name") == name:
                return candidate

    return None


def _bootstrap_ensure_project(api_base: str, args: argparse.Namespace, actor: Optional[str]) -> Dict[str, Any]:
    host = (args.gitlab_host or "").rstrip("/")
    project_path = (args.project_path or "").strip("/")
    allowlist_entries, allowlist_specified = _parse_allowlist(args.allowlist)

    snapshot = _api_request(api_base, "GET", "/projects")
    projects: List[Dict[str, Any]] = snapshot or []
    if not isinstance(projects, list):
        projects = []

    existing = _select_existing_project(projects, host, project_path, args.project_name)

    if existing is not None:
        project_id = existing.get("id")
        update_payload: Dict[str, Any] = {}

        if args.project_name and args.project_name != existing.get("name"):
            update_payload["name"] = args.project_name
        if args.default_branch and args.default_branch != existing.get("default_branch"):
            update_payload["default_branch"] = args.default_branch
        if host and host != (existing.get("gitlab_host") or "").rstrip("/"):
            update_payload["gitlab_host"] = host
        if project_path and project_path != (existing.get("gitlab_project_path") or "").strip("/"):
            update_payload["gitlab_project_path"] = project_path
        if allowlist_specified:
            update_payload["allowlist"] = allowlist_entries or []

        project_state: Dict[str, Any]
        if update_payload:
            if actor:
                update_payload["actor"] = actor
            project_state = _api_request(
                api_base,
                "PATCH",
                f"/projects/{project_id}",
                update_payload,
            )
        else:
            project_state = existing

        detail = _api_request(api_base, "GET", f"/projects/{project_id}")
        if isinstance(detail, dict):
            return detail
        return project_state

    missing_fields = []
    if not args.project_name:
        missing_fields.append("--project-name")
    if not host:
        missing_fields.append("--gitlab-host")
    if not project_path:
        missing_fields.append("--project-path")
    if not args.default_branch:
        missing_fields.append("--default-branch")

    if missing_fields:
        joined = ", ".join(missing_fields)
        raise RuntimeError(f"Project does not exist; provide {joined}")

    create_payload: Dict[str, Any] = {
        "name": args.project_name,
        "default_branch": args.default_branch,
        "gitlab_host": host,
        "gitlab_project_path": project_path,
    }
    if allowlist_specified:
        create_payload["allowlist"] = allowlist_entries or []

    created = _api_request(api_base, "POST", "/projects", create_payload)
    project_id = created.get("id") if isinstance(created, dict) else None

    if project_id is not None:
        detail = _api_request(api_base, "GET", f"/projects/{project_id}")
        if isinstance(detail, dict):
            return detail
    return created


def projects_bootstrap(args: argparse.Namespace) -> int:
    api_base = _resolve_api_base(args.api_base)
    actor = args.actor.strip() if args.actor and args.actor.strip() else None
    _ = getattr(args, "ui_base_url", None)  # compatibility shim; flag reserved for future use

    try:
        pat_status = _bootstrap_handle_credentials(
            api_base,
            actor,
            args.gitlab_pat,
            args.project_pat,
            args.session_bundle_path,
            args.session_bundle,
        )
        project_payload = _bootstrap_ensure_project(api_base, args, actor)
    except RuntimeError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1

    if not isinstance(pat_status, dict):
        pat_status = {}
    if not isinstance(project_payload, dict):
        print("error: unexpected response payload when bootstrapping project", file=sys.stderr)
        return 1

    result = {
        "project": project_payload,
        "pat": pat_status,
        "allowlist": project_payload.get("allowlist", []),
    }

    if args.json:
        print(json.dumps(result))
    else:
        project_id = project_payload.get("id")
        print(
            "Project ready: {name} (id={pid})".format(
                name=project_payload.get("name"),
                pid=project_id if project_id is not None else "--",
            )
        )
        print(f"  GitLab host: {project_payload.get('gitlab_host')}")
        print(f"  Project path: {project_payload.get('gitlab_project_path')}")
        print(f"  Default branch: {project_payload.get('default_branch')}")
        allowlist = project_payload.get("allowlist") or []
        if allowlist:
            print("  Allowlist: " + ", ".join(allowlist))
        else:
            print("  Allowlist: <empty>")
        pat_state = "configured" if pat_status.get("configured") else "missing"
        print(f"  GitLab PAT: {pat_state}")

    return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="codex", description="Codex helper CLI")
    subparsers = parser.add_subparsers(dest="command", required=True)

    pat_parser = subparsers.add_parser("pat", help="Manage GitLab personal access tokens")
    pat_subparsers = pat_parser.add_subparsers(dest="pat_command", required=True)

    default_api = os.getenv(ENV_BACKEND_API_BASE, DEFAULT_API_BASE)

    def _configure_pat_store(parser: argparse.ArgumentParser, *, deprecated: bool = False) -> None:
        parser.add_argument("--token", "-t", required=True, help="PAT value to store")
        parser.add_argument("--actor", "-a", help="Operator performing the update")
        parser.add_argument(
            "--api-base",
            default=default_api,
            help="Override API base URL (default: %(default)s)",
        )
        parser.add_argument("--dry-run", action="store_true", help="Skip network calls and print intent")
        parser.set_defaults(func=store_pat, deprecated_command=deprecated)

    store_parser = pat_subparsers.add_parser("store", help="Store the GitLab PAT")
    _configure_pat_store(store_parser)

    rotate_parser = pat_subparsers.add_parser(
        "rotate",
        help="(deprecated) Store the GitLab PAT",
    )
    _configure_pat_store(rotate_parser, deprecated=True)

    clear_parser = pat_subparsers.add_parser("clear", help="Clear the stored GitLab PAT")
    clear_parser.add_argument("--actor", "-a", help="Operator performing the clear action")
    clear_parser.add_argument(
        "--api-base",
        default=default_api,
        help="Override API base URL (default: %(default)s)",
    )
    clear_parser.add_argument("--dry-run", action="store_true", help="Skip network calls and print intent")
    clear_parser.set_defaults(func=clear_pat)

    import_session = pat_subparsers.add_parser(
        "import-chatgpt",
        help="Import a ChatGPT session bundle",
    )
    import_session.add_argument(
        "--file",
        "-f",
        help="Path to the auth.json bundle emitted by `codex login`",
    )
    import_session.add_argument(
        "--bundle",
        help="Raw bundle contents (alternative to --file)",
    )
    import_session.add_argument("--actor", "-a", help="Operator performing the import")
    import_session.add_argument(
        "--api-base",
        default=default_api,
        help="Override API base URL (default: %(default)s)",
    )
    import_session.add_argument("--dry-run", action="store_true", help="Skip network calls and print intent")
    import_session.set_defaults(func=import_chatgpt_session)

    clear_session = pat_subparsers.add_parser(
        "clear-chatgpt",
        help="Clear the stored ChatGPT session bundle",
    )
    clear_session.add_argument("--actor", "-a", help="Operator performing the clear action")
    clear_session.add_argument(
        "--api-base",
        default=default_api,
        help="Override API base URL (default: %(default)s)",
    )
    clear_session.add_argument("--dry-run", action="store_true", help="Skip network calls and print intent")
    clear_session.set_defaults(func=clear_chatgpt_session)

    projects_parser = subparsers.add_parser("projects", help="Manage projects")
    projects_subparsers = projects_parser.add_subparsers(dest="projects_command", required=True)

    bootstrap_parser = projects_subparsers.add_parser(
        "bootstrap",
        help="Ensure credentials and a project record exist for automation",
    )
    bootstrap_parser.add_argument("--api-base", default=default_api, help="Override API base URL")
    bootstrap_parser.add_argument("--project-name", help="Project display name")
    bootstrap_parser.add_argument("--gitlab-host", help="GitLab host (e.g. https://gitlab.com)")
    bootstrap_parser.add_argument("--project-path", help="Namespace/repository path")
    bootstrap_parser.add_argument("--default-branch", help="Default branch for new tasks")
    bootstrap_parser.add_argument(
        "--allowlist",
        action="append",
        default=None,
        help="Allowlisted domains (comma separated or repeat flag)",
    )
    bootstrap_parser.add_argument("--gitlab-pat", help="GitLab PAT to store if missing")
    bootstrap_parser.add_argument(
        "--project-pat",
        help="Legacy project-specific PAT (treated as global PAT)",
    )
    bootstrap_parser.add_argument(
        "--session-bundle-path",
        help="Path to ChatGPT session bundle to import",
    )
    bootstrap_parser.add_argument(
        "--session-bundle",
        help="Inline ChatGPT session bundle JSON",
    )
    bootstrap_parser.add_argument("--actor", help="Operator recorded in audit logs")
    bootstrap_parser.add_argument(
        "--ui-base-url",
        help="Unused placeholder maintained for compatibility",
    )
    bootstrap_parser.add_argument("--json", action="store_true", help="Emit JSON payload only")
    bootstrap_parser.set_defaults(func=projects_bootstrap)

    args = parser.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":  # pragma: no cover - CLI entrypoint
    sys.exit(main())
