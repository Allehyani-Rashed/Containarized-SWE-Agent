# Copy to .env.e2e.local and adjust values before running `make e2e-ui`.
# Tokens below are placeholders; replace with real credentials for live runs.

# GitLab personal access token with api and write_repository scopes.
E2E_GITLAB_PAT=glpat-playwright-placeholder

# Path to the ChatGPT session bundle (auth.json) used for Codex authentication.
# Set to the location of a throwaway bundle created via `codex login`.
E2E_CHATGPT_SESSION_BUNDLE_PATH=/absolute/path/to/chatgpt_session_bundle.json

# Alternatively, provide the session contents inline (takes precedence over the path).
# Keep only one of these populated.
# E2E_CHATGPT_SESSION_JSON='{"session_token":"..."}'

# GitLab host and project path where Codex tasks should run.
E2E_GITLAB_HOST=https://gitlab.example.com
E2E_GITLAB_PROJECT_PATH=example/playwright-e2e

# Default branch to target when submitting Codex tasks.
E2E_DEFAULT_TARGET_BRANCH=main

# Optional: override Docker socket when running against Docker Desktop.
# E2E_DOCKER_HOST=unix:///Users/rashed/.docker/run/docker.sock

# Optional: base URLs when the backend/UI run on non-default ports.
# E2E_API_BASE_URL=http://127.0.0.1:8000
# E2E_UI_BASE_URL=http://127.0.0.1:5173

# Set to 1 to require the real Docker-backed Codex stack during E2E runs.
# When unset or 0 (default) the suite forces the local stub to avoid network changes.
# E2E_REQUIRE_REAL_STACK=0
